# --- 1. ЗАВИСИМОСТИ (Самое важное!) ---
node_modules/
bower_components/
jspm_packages/

# --- 2. СБОРКА И РЕЗУЛЬТАТЫ КОМПИЛЯЦИИ ---
dist/
build/
out/
*.min.js
*.map

# --- 3. СИСТЕМНЫЕ ФАЙЛЫ И ОС ---
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# --- 4. РЕДАКТОРЫ И IDE (VS Code) ---
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.history/

# --- 5. ЛОГИ И ВРЕМЕННЫЕ ФАЙЛЫ ---
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*
*.log

# --- 6. ПЕРЕМЕННЫЕ ОКРУЖЕНИЯ (Безопасность!) ---
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# --- 7. ТЕСТЫ И ПОКРЫТИЕ ---
coverage/
.nyc_output/

# --- 8. ПАКЕТНЫЕ МЕНЕДЖЕРЫ ---
# Оставляем только тот lock-файл, который соответствует вашему менеджеру.
# Остальные игнорируем, чтобы не было путаницы.

# Если используете npm (по умолчанию):
yarn.lock
pnpm-lock.yaml

# Если используете yarn — закомментируйте строку выше и раскомментируйте эту:
# package-lock.json
# pnpm-lock.yaml

# Если используете pnpm — закомментируйте обе строки выше и раскомментируйте эту:
# package-lock.json
# yarn.lock